{
  "name": "dopefolio",
  "version": "1.0.0",
  "description": "Brandon Smith — technical game designer portfolio",
  "main": "index.js",
  "scripts": {
    "compile:scss": "sass --watch --no-source-map sass/main.scss css/style.css",
    "build:css": "sass --no-source-map --style=expanded sass/main.scss css/style.css",
    "prefix:css": "postcss css/style.css --use autoprefixer --replace",
    "compress:css": "sass --no-source-map --style=compressed css/style.css css/style.css",
    "build": "npm-run-all build:css prefix:css compress:css"
  },
  "author": "Brandon Smith",
  "license": "GPL-3.0",
  "devDependencies": {
    "autoprefixer": "^10.3.1",
    "npm-run-all": "^4.1.5",
    "postcss-cli": "^8.3.1",
    "sass": "^1.104.1"
  },
  "browserslist": [
    "last 2 versions",
    "> 1%",
    "not dead"
  ]
}
